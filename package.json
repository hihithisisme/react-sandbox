{
    "name": "react-sandbox",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "ts-node server.ts",
        "dev-server": "reflex -s --decoration=none -g \"./public/static/*/*.{html,js}\" npm run dev",
        "build": "next build && tsc --project tsconfig.server.json",
        "start": "NODE_ENV=production node .next/server.js",
        "lint": "next lint --fix"
    },
    "dependencies": {
        "@chakra-ui/icons": "^2.2.4",
        "@chakra-ui/react": "^3.17.0",
        "@dnd-kit/core": "^6.0.2",
        "@emotion/react": "^11.14.0",
        "@phosphor-icons/react": "^2.1.7",
        "@svgdotjs/svg.js": "^3.1.2",
        "axios": "^0.27.2",
        "downshift": "^9.0.9",
        "express": "^4.18.1",
        "next": "^15.3.1",
        "next-themes": "^0.4.6",
        "open-simplex-noise": "^2.5.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-icons": "^5.5.0",
        "react-use-websocket": "^3.0.0",
        "tinycolor2": "^1.4.2",
        "uuid": "^8.3.2",
        "ws": "^8.6.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.13",
        "@types/node": "17.0.30",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.3",
        "@types/tinycolor2": "^1.4.3",
        "@types/uuid": "^8.3.4",
        "@types/ws": "^8.5.3",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "eslint": "^9.26.0",
        "eslint-config-next": "^15.3.1",
        "eslint-plugin-filenames": "^1.3.2",
        "eslint-plugin-jest": "^28.11.0",
        "prettier": "^2.6.2",
        "ts-node": "^10.7.0",
        "typescript": "^5.8.2"
    },
    "engines": {
        "node": "20.x"
    }
}
